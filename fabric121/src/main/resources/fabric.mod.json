{
  "schemaVersion": 1,
  "id": "whatchanged",
  "version": "${version}",
  "name": "What Changed?",
  "description": "Automatic modpack changelog. After every modpack update it shows exactly which mods, items, mobs, recipes, biomes, structures, enchantments and dimensions were added, removed or changed.",
  "authors": ["pokato"],
  "license": "MIT",
  "icon": "assets/whatchanged/icon.png",
  "environment": "*",
  "entrypoints": {
    "main":   ["com.pokato.whatchanged.fabric121.WhatChangedFabric"],
    "client": ["com.pokato.whatchanged.fabric121.WhatChangedFabricClient"]
  },
  "depends": {
    "fabricloader": ">=0.16.0",
    "minecraft":    [">=1.21.8", "<=1.21.11"],
    "java":         ">=21",
    "fabric-api":   "*"
  }
}
